# ============================================================
# PREGNACARE AI - ENVIRONMENT VARIABLES
# ============================================================

# Database Configuration (PostgreSQL / SQLite fallback for development)
# Docker / Production: postgresql://postgres:postgres@localhost:5432/pregnacare_ai?schema=public
# Local fallback: file:./dev.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pregnacare_ai?schema=public

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=pregnacare_ai_super_secret_jwt_key_2026_dev_mode
JWT_EXPIRES_IN=7d

# CORS Configuration (Web frontends allowed)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Service (Google Gemini / LLM Integration)
# Kept securely on backend only - never exposed to clients
LLM_API_KEY=your_gemini_or_llm_api_key_here
GEMINI_API_KEY=your_gemini_or_llm_api_key_here

# Frontend Configuration (Web Vite)
VITE_API_URL=http://localhost:5000/api

# Mobile Configuration (React Native / Expo)
EXPO_PUBLIC_API_URL=http://localhost:5000/api
