# ============================================================
# PREGNACARE AI - ENVIRONMENT VARIABLES & VERCEL DEPLOYMENT
# ============================================================

# ------------------------------------------------------------
# 1. SERVER SERVICE (Backend / Node.js + Express)
# ------------------------------------------------------------

# Database Connection (Hosted PostgreSQL for production / Vercel)
# Examples: Supabase, Neon, AWS RDS, Railway
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pregnacare_ai?schema=public

# Server Port (Automatically set by Vercel in production)
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
# Note: Vercel preview/production domains (*.vercel.app) are automatically permitted
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# AI Service (Google Gemini / LLM Integration)
# Kept strictly on backend server only - never exposed to clients
LLM_API_KEY=your_gemini_or_llm_api_key_here
GEMINI_API_KEY=your_gemini_or_llm_api_key_here

# ------------------------------------------------------------
# 2. WEB SERVICE (Frontend / React 18 + Vite)
# ------------------------------------------------------------

# API Base URL
# Development: http://localhost:5000/api
# Production (Vercel): Leave unset or use /api (relative rewrite)
VITE_API_URL=/api

# ------------------------------------------------------------
# 3. MOBILE APPLICATION (React Native / Expo Android)
# ------------------------------------------------------------

# Mobile points to the deployed Vercel domain or local IP
# Example: https://your-pregnacare-deployment.vercel.app/api
EXPO_PUBLIC_API_URL=https://your-pregnacare-deployment.vercel.app/api
